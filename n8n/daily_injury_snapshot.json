        "attributes": {
          "attributes": [
            {
              "name": "category",
              "description": "One of: injured, doubtful, suspended, loan_or_transfer, other. Use “injured” if the player is ruled out by injury, “doubtful” if his availability is uncertain, “suspended” for bans. Use loan_or_transfer also for players who left the club or became free agents. Any text with a percentage chance of playing (25%, 50%, 75%) is doubtful. Use injured when the text says injury with an unknown return date or an expected return date and no percentage.",
              "required": true
            },
            {
              "name": "body_part",
              "description": "The injured body part in lowercase English, like hamstring or knee. Leave empty if none is mentioned. For a muscular injury use muscle."
            },
            {
              "name": "expected_return",
              "description": "The expected return date as YYYY-MM-DD, if the text gives one. Leave empty if there is no date. If the text says Expected back followed by a day and month, always fill this field, in the next future year."
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "You are an expert extraction algorithm.\nOnly extract relevant information from the text.\nAlways return all three fields. If a value is not in the text, return an empty string.",
